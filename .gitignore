# Local state — the bucket is the truth.
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfstate.*

# Environment-specific, sometimes sensitive.
*.tfvars
backend.hcl

# Doc tooling. solution-architecture.pdf is committed; it is generated from
# docs/ by tools/make-pdf.js, so never edit it by hand.
tools/node_modules/
tools/print.html

# Plans can embed sensitive values.
crash.log
*.tfplan

# .terraform.lock.hcl is committed on purpose — it pins provider checksums.
